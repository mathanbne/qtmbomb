# Firebase web config for the qtm-bomb project (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Public URL players are sent to by the QR code (defaults to the current site)
VITE_PUBLIC_URL=https://bomb.qtm.org.au
